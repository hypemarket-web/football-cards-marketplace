* {
  box-sizing: border-box;
}

:root {
  --bg: #f3f7ff;
  --panel: #ffffff;
  --card: #edf3ff;
  --primary: #123d8b;
  --primary-dark: #0d2e68;
  --accent: #22c55e;
  --text: #152033;
  --muted: #62718c;
  --border: #dfe8f9;
  --shadow: 0 20px 45px rgba(18, 61, 139, 0.12);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #eef5ff 0%, #f7f9fc 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.page-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 32px;
  padding: 18px 24px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border);
  border-radius: 22px;
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow);
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, #0a3d9d, #2a91ff);
  color: #fff;
  font-size: 1.5rem;
}

.kicker {
  margin: 0;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.logo-wrap h1 {
  margin: 4px 0 0;
  font-size: clamp(1.2rem, 1.1rem + 0.7vw, 2rem);
}

.nav-links {
  display: flex;
  gap: 18px;
  font-weight: 600;
  color: var(--muted);
}

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.9fr) minmax(330px, 0.95fr);
  gap: 28px;
  align-items: flex-start;
}

.shop-panel,
.cart-panel {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.shop-panel {
  padding: 22px;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 10px 6px 24px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 10px;
  padding: 7px 12px;
  border-radius: 999px;
  background: #dff7e8;
  color: #0a7d42;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.hero h2 {
  margin: 0;
  font-size: clamp(2rem, 1.6rem + 1.2vw, 3rem);
}

.search-box {
  width: min(100%, 320px);
}

.search-box input {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  background: #f9fbff;
  color: var(--text);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.product-card {
  overflow: hidden;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(18, 61, 139, 0.08);
}

.product-card img {
  display: block;
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.product-body {
  padding: 16px;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  font-size: 0.8rem;
  color: var(--muted);
}

.product-body h3 {
  min-height: 48px;
  margin: 12px 0;
  font-size: 1.1rem;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.product-footer strong {
  font-size: 1.3rem;
}

.product-footer button,
.checkout-button,
.quantity-controls button {
  border: none;
  border-radius: 10px;
  transition: opacity 0.2s ease;
}

.product-footer button,
.checkout-button {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  padding: 10px 14px;
  font-weight: 700;
}

.product-footer button:hover,
.checkout-button:hover {
  opacity: 0.96;
}

.cart-panel {
  padding: 22px 20px;
  position: sticky;
  top: 16px;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.cart-header h3 {
  margin: 0;
  font-size: 1.4rem;
}

.cart-header span {
  color: var(--muted);
  font-size: 0.85rem;
}

.empty-cart {
  background: #f8faff;
  border: 1px dashed var(--border);
  border-radius: 14px;
  padding: 18px;
  text-align: center;
  color: var(--muted);
}

.empty-cart p {
  margin: 0 0 6px;
  color: var(--text);
  font-weight: 600;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 10px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #fbfcff;
}

.cart-item h4 {
  margin: 0 0 6px;
  font-size: 0.98rem;
}

.cart-item p {
  margin: 0;
  color: var(--muted);
  font-size: 0.86rem;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-left: 10px;
}

.quantity-controls button {
  width: 28px;
  height: 28px;
  background: var(--card);
  color: var(--primary);
  font-size: 1.2rem;
  font-weight: 700;
}

.order-summary {
  margin-top: 20px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.order-summary > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
}

.order-summary .grand-total {
  margin-top: 8px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  color: var(--text);
  font-size: 1.1rem;
}

.checkout-form {
  margin-top: 22px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.checkout-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: var(--text);
  font-weight: 600;
  font-size: 0.9rem;
}

.checkout-form input,
.checkout-form textarea {
  background: #f9fbff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  color: var(--text);
}

.payment-box {
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #f5f9ff;
}

.payment-label {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
}

.payment-option {
  display: flex;
  align-items: center;
  gap: 10px;
}

.payment-option input {
  accent-color: var(--primary);
}

.checkout-button {
  width: 100%;
  margin-top: 12px;
  padding: 12px 16px;
}

.success-message {
  margin-top: 18px;
  padding: 16px;
  border-radius: 14px;
  background: #eafaf1;
  border: 1px solid #cdeed9;
  color: #0a6a39;
}

.success-message h4 {
  margin: 0 0 8px;
}

.success-message p {
  margin: 0;
}

@media (max-width: 1000px) {
  .content-grid {
    grid-template-columns: 1fr;
  }

  .cart-panel {
    position: static;
  }
}

@media (max-width: 700px) {
  .topbar,
  .hero {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-links {
    width: 100%;
    justify-content: space-between;
  }

  .shop-panel,
  .cart-panel {
    border-radius: 20px;
  }
}
